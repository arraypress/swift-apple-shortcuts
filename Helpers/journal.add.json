{
  "id": "journal.add",
  "tool": "journal",
  "title": "Add Entry",
  "description": "Adds an entry to Apple Journal: a title, words, a date, and a bookmark if asked.",
  "version": 1,
  "icon": {
    "glyph": 61586,
    "color": "orange"
  },
  "input": [
    {
      "name": "title",
      "type": "string",
      "description": "the entry's title"
    },
    {
      "name": "text",
      "type": "string",
      "description": "the entry's words"
    },
    {
      "name": "date",
      "type": "string",
      "description": "the day it is for, yyyy-MM-dd HH:mm"
    },
    {
      "name": "bookmark",
      "type": "bool",
      "description": "true bookmarks it"
    }
  ],
  "output": {
    "type": "none",
    "description": "journal reads Journal's own store back"
  },
  "steps": [
    {
      "action": "is.workflow.actions.detect.dictionary",
      "parameters": {
        "WFInput": "$input"
      }
    },
    {
      "action": "is.workflow.actions.setvariable",
      "parameters": {
        "WFVariableName": "jnInput",
        "WFInput": "$previous"
      }
    },
    {
      "action": "is.workflow.actions.getvalueforkey",
      "parameters": {
        "WFGetDictionaryValueType": "Value",
        "WFDictionaryKey": "title",
        "WFInput": "${jnInput}"
      }
    },
    {
      "action": "is.workflow.actions.setvariable",
      "parameters": {
        "WFVariableName": "jnTitle",
        "WFInput": "$previous"
      }
    },
    {
      "action": "is.workflow.actions.getvalueforkey",
      "parameters": {
        "WFGetDictionaryValueType": "Value",
        "WFDictionaryKey": "text",
        "WFInput": "${jnInput}"
      }
    },
    {
      "action": "is.workflow.actions.setvariable",
      "parameters": {
        "WFVariableName": "jnText",
        "WFInput": "$previous"
      }
    },
    {
      "action": "is.workflow.actions.getvalueforkey",
      "parameters": {
        "WFGetDictionaryValueType": "Value",
        "WFDictionaryKey": "date",
        "WFInput": "${jnInput}"
      }
    },
    {
      "action": "is.workflow.actions.detect.date",
      "parameters": {
        "WFInput": "$previous"
      }
    },
    {
      "action": "is.workflow.actions.setvariable",
      "parameters": {
        "WFVariableName": "jnDate",
        "WFInput": "$previous"
      }
    },
    {
      "action": "is.workflow.actions.getvalueforkey",
      "parameters": {
        "WFGetDictionaryValueType": "Value",
        "WFDictionaryKey": "bookmark",
        "WFInput": "${jnInput}"
      }
    },
    {
      "action": "is.workflow.actions.setvariable",
      "parameters": {
        "WFVariableName": "jnBookmark",
        "WFInput": "$previous"
      }
    },
    {
      "action": "com.apple.journal.CreateEntryIntent",
      "parameters": {
        "title": "${jnTitle}",
        "message": "${jnText}",
        "entryDate": "${jnDate}",
        "entryBookmark": "${jnBookmark}",
        "OpenWhenRun": false
      }
    },
    {
      "action": "is.workflow.actions.nothing"
    }
  ],
  "notes": [
    "Journal's Create Entry action cannot choose a journal: entries go where Journal puts new ones.",
    "No edit or delete: Journal offers no action for either."
  ],
  "replaces": [],
  "install": "journal doctor --install"
}
